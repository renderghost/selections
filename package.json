{
  "name": "selections",
  "version": "2.0.0",
  "description": "SoundSelections — a fast, responsive browser for Barry Prendergast's curated TIDAL playlists.",
  "private": true,
  "type": "module",
  "main": "app.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "node app.js",
    "dev": "node --watch-path=src --watch-path=views app.js",
    "dev:mock": "TIDAL_MOCK=1 node --watch-path=src --watch-path=views app.js",
    "tidal:login": "node scripts/tidal-login.js",
    "check": "node scripts/check-syntax.js",
    "test": "node --test --test-reporter=spec \"test/**/*.test.js\""
  },
  "keywords": [],
  "author": "Barry Prendergast",
  "license": "MIT",
  "dependencies": {
    "@sentry/node": "^11.9.0",
    "@vercel/functions": "^3.10.3",
    "compression": "^1.8.2",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0"
  },
  "devDependencies": {
    "pino-pretty": "^13.2.0"
  }
}
