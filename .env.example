# Copy to `.env` and fill in. Never commit `.env`.

# --- TIDAL (required) -------------------------------------------------------
# From your app at https://developer.tidal.com/dashboard
TIDAL_CLIENT_ID=
TIDAL_CLIENT_SECRET=

# Your TIDAL user ID — the playlists owned by this user are shown.
# `npm run tidal:login` prints it for you.
TIDAL_USER_ID=

# Only needed if TIDAL rejects client-credentials access to your playlists.
# Run `npm run tidal:login` once to obtain it. Treat it like a password.
TIDAL_REFRESH_TOKEN=

# Redirect URI registered in the TIDAL dashboard, used by `npm run tidal:login`.
# TIDAL_REDIRECT_URI=http://localhost:3000/callback

# ISO 3166-1 country code sent to the TIDAL API.
# TIDAL_COUNTRY_CODE=GB

# --- Site ------------------------------------------------------------------
# Public URL of the site (used for social sharing tags). On Vercel, defaults to
# the project's production URL; set it if you use a custom domain.
# SITE_URL=https://example.com
# Link for the "View on TIDAL" button in the footer. Hidden if empty.
TIDAL_PROFILE_URL=

# --- Behaviour -------------------------------------------------------------
# How long the server trusts its copy of your playlists before re-checking TIDAL (ms).
CACHE_DURATION=600000
# On Vercel: how long the CDN serves cached playlist data before refreshing (seconds).
# CDN_CACHE_SECONDS=600
# PORT=3000
# LOG_LEVEL=info

# --- Error reporting (optional) ---------------------------------------------
# Set to send server and browser errors to Sentry (https://sentry.io).
# SENTRY_DSN=

# --- Local development ------------------------------------------------------
# Serve generated demo playlists instead of calling TIDAL (`npm run dev:mock`).
# TIDAL_MOCK=1
